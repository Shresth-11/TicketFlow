{
  "buildCommand": "cd ticketflow-frontend && npm install && npm run build",
  "outputDirectory": "ticketflow-frontend/dist",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://ticketflow-backend.onrender.com/api/v1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
